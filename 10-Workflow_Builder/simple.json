{ 
  "name": "Weekly Social Media Analytics Report",
  "flow": [
    {
      "id": 1,
      "module": "builtin:schedule",
      "version": 1,
      "parameters": {
        "cron": "0 8 * * 1",
        "timezone": "Europe/Paris"
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Schedule Trigger - Monday 8AM"
        },
        "restore": {},
        "parameters": [
          {
            "name": "cron",
            "type": "text",
            "label": "Schedule",
            "required": true
          }
        ]
      }
    },
    {
      "id": 2,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "scope": "roundtrip",
        "value": "{{formatDate(addDays(now; -7); \"YYYY-MM-DD\")}}",
        "name": "startDate"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Set Start Date (7 days ago)"
        }
      }
    },
    {
      "id": 3,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "scope": "roundtrip",
        "value": "{{formatDate(addDays(now; -1); \"YYYY-MM-DD\")}}",
        "name": "endDate"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "Set End Date (Yesterday)"
        }
      }
    },
    {
      "id": 4,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true
      },
      "mapper": {
        "url": "https://graph.facebook.com/v18.0/me/insights",
        "method": "GET",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{connection.accessToken}}"
          }
        ],
        "qs": [
          {
            "name": "metric",
            "value": "page_impressions,page_reach,page_engaged_users"
          },
          {
            "name": "since",
            "value": "{{2.startDate}}"
          },
          {
            "name": "until",
            "value": "{{3.endDate}}"
          },
          {
            "name": "period",
            "value": "week"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": -150,
          "name": "Fetch Facebook Analytics"
        }
      }
    },
    {
      "id": 5,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true
      },
      "mapper": {
        "url": "https://api.twitter.com/2/users/me/tweets",
        "method": "GET",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{connection.bearerToken}}"
          }
        ],
        "qs": [
          {
            "name": "tweet.fields",
            "value": "public_metrics,created_at"
          },
          {
            "name": "start_time",
            "value": "{{2.startDate}}T00:00:00.000Z"
          },
          {
            "name": "end_time",
            "value": "{{3.endDate}}T23:59:59.000Z"
          },
          {
            "name": "max_results",
            "value": "100"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0,
          "name": "Fetch Twitter Analytics"
        }
      }
    },
    {
      "id": 6,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true
      },
      "mapper": {
        "url": "https://api.linkedin.com/v2/organizationalEntityShareStatistics",
        "method": "GET",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer {{connection.accessToken}}"
          }
        ],
        "qs": [
          {
            "name": "q",
            "value": "organizationalEntity"
          },
          {
            "name": "organizationalEntity",
            "value": "{{connection.organizationId}}"
          },
          {
            "name": "timeIntervals.timeGranularityType",
            "value": "DAY"
          },
          {
            "name": "timeIntervals.timeRange.start",
            "value": "{{parseDate(2.startDate + \"T00:00:00.000Z\"; \"X\") * 1000}}"
          },
          {
            "name": "timeIntervals.timeRange.end",
            "value": "{{parseDate(3.endDate + \"T23:59:59.000Z\"; \"X\") * 1000}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 150,
          "name": "Fetch LinkedIn Analytics"
        }
      }
    },
    {
      "id": 7,
      "module": "json:ParseJSON",
      "version": 1,
      "parameters": {},
      "mapper": {
        "json": "{{4.data}}"
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": -150,
          "name": "Parse Facebook Data"
        }
      }
    },
    {
      "id": 8,
      "module": "json:ParseJSON",
      "version": 1,
      "parameters": {},
      "mapper": {
        "json": "{{5.data}}"
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0,
          "name": "Parse Twitter Data"
        }
      }
    },
    {
      "id": 9,
      "module": "json:ParseJSON",
      "version": 1,
      "parameters": {},
      "mapper": {
        "json": "{{6.data}}"
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 150,
          "name": "Parse LinkedIn Data"
        }
      }
    },
    {
      "id": 10,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "scope": "roundtrip",
        "value": "{{if(exists(7.data); sum(map(7.data; \"values.0.value\")); 0)}}",
        "name": "facebookImpressions"
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": -150,
          "name": "Calculate Facebook Impressions"
        }
      }
    },
    {
      "id": 11,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "scope": "roundtrip",
        "value": "{{if(exists(7.data); get(filter(7.data; name = \"page_reach\"); \"values.0.value.0\"); 0)}}",
        "name": "facebookReach"
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": -100,
          "name": "Calculate Facebook Reach"
        }
      }
    },
    {
      "id": 12,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "scope": "roundtrip",
        "value": "{{if(exists(7.data) and exists(11.facebookReach) and 11.facebookReach > 0; round(get(filter(7.data; name = \"page_engaged_users\"); \"values.0.value.0\") / 11.facebookReach * 100; 2); 0)}}",
        "name": "facebookEngagementRate"
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": -50,
          "name": "Calculate Facebook Engagement Rate"
        }
      }
    },
    {
      "id": 13,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "scope": "roundtrip",
        "value": "{{if(exists(8.data); sum(map(8.data; \"public_metrics.impression_count\")); 0)}}",
        "name": "twitterImpressions"
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 0,
          "name": "Calculate Twitter Impressions"
        }
      }
    },
    {
      "id": 14,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "scope": "roundtrip",
        "value": "{{if(exists(8.data); sum(map(8.data; \"public_metrics.like_count\")); 0)}}",
        "name": "twitterEngagements"
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 50,
          "name": "Calculate Twitter Engagements"
        }
      }
    },
    {
      "id": 15,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "scope": "roundtrip",
        "value": "{{if(exists(13.twitterImpressions) and 13.twitterImpressions > 0; round(14.twitterEngagements / 13.twitterImpressions * 100; 2); 0)}}",
        "name": "twitterEngagementRate"
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 100,
          "name": "Calculate Twitter Engagement Rate"
        }
      }
    },
    {
      "id": 16,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "scope": "roundtrip",
        "value": "{{if(exists(9.elements); sum(map(9.elements; \"totalShareStatistics.impressionCount\")); 0)}}",
        "name": "linkedinImpressions"
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 150,
          "name": "Calculate LinkedIn Impressions"
        }
      }
    },
    {
      "id": 17,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "scope": "roundtrip",
        "value": "{{if(exists(9.elements); sum(map(9.elements; \"totalShareStatistics.uniqueImpressionsCount\")); 0)}}",
        "name": "linkedinReach"
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 200,
          "name": "Calculate LinkedIn Reach"
        }
      }
    },
    {
      "id": 18,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "scope": "roundtrip",
        "value": "{{if(exists(9.elements) and exists(16.linkedinImpressions) and 16.linkedinImpressions > 0; round(sum(map(9.elements; \"totalShareStatistics.engagementCount\")) / 16.linkedinImpressions * 100; 2); 0)}}",
        "name": "linkedinEngagementRate"
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 250,
          "name": "Calculate LinkedIn Engagement Rate"
        }
      }
    },
    {
      "id": 19,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "scope": "roundtrip",
        "value": "{{10.facebookImpressions + 13.twitterImpressions + 16.linkedinImpressions}}",
        "name": "totalImpressions"
      },
      "metadata": {
        "designer": {
          "x": 1800,
          "y": 0,
          "name": "Calculate Total Impressions"
        }
      }
    },
    {
      "id": 20,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "scope": "roundtrip",
        "value": "{{11.facebookReach + 13.twitterImpressions + 17.linkedinReach}}",
        "name": "totalReach"
      },
      "metadata": {
        "designer": {
          "x": 1800,
          "y": 50,
          "name": "Calculate Total Reach"
        }
      }
    },
    {
      "id": 21,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "scope": "roundtrip",
        "value": "{{if(19.totalImpressions > 0; round((12.facebookEngagementRate + 15.twitterEngagementRate + 18.linkedinEngagementRate) / 3; 2); 0)}}",
        "name": "avgEngagementRate"
      },
      "metadata": {
        "designer": {
          "x": 1800,
          "y": 100,
          "name": "Calculate Average Engagement Rate"
        }
      }
    },
    {
      "id": 22,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "scope": "roundtrip",
        "value": "Weekly Social Media Analytics Report — {{formatDate(2.startDate; \"MMM DD\")}} - {{formatDate(3.endDate; \"MMM DD, YYYY\")}}",
        "name": "emailSubject"
      },
      "metadata": {
        "designer": {
          "x": 2100,
          "y": 0,
          "name": "Generate Email Subject"
        }
      }
    },
    {
      "id": 23,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "scope": "roundtrip",
        "value": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>{{22.emailSubject}}</title>\n    <style>\n        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 800px; margin: 0 auto; padding: 20px; }\n        .header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 30px; border-radius: 10px; text-align: center; margin-bottom: 30px; }\n        .metric-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 30px; }\n        .metric-card { background: #f8f9fa; border: 2px solid #e9ecef; border-radius: 8px; padding: 20px; text-align: center; }\n        .metric-value { font-size: 2em; font-weight: bold; color: #495057; margin-bottom: 5px; }\n        .metric-label { font-size: 0.9em; color: #6c757d; text-transform: uppercase; letter-spacing: 1px; }\n        .platform-section { margin-bottom: 30px; }\n        .platform-title { background: #495057; color: white; padding: 15px; margin-bottom: 15px; border-radius: 5px; }\n        .platform-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 15px; }\n        .platform-stat { background: white; border: 1px solid #dee2e6; padding: 15px; border-radius: 5px; text-align: center; }\n        .footer { text-align: center; padding: 20px; color: #6c757d; font-size: 0.9em; }\n    </style>\n</head>\n<body>\n    <div class=\"header\">\n        <h1>📊 Weekly Social Media Analytics</h1>\n        <p>{{formatDate(2.startDate; \"MMMM DD\")}} - {{formatDate(3.endDate; \"MMMM DD, YYYY\")}}</p>\n    </div>\n    \n    <div class=\"metric-grid\">\n        <div class=\"metric-card\">\n            <div class=\"metric-value\">{{formatNumber(19.totalImpressions; \"#,##0\")}}</div>\n            <div class=\"metric-label\">Total Impressions</div>\n        </div>\n        <div class=\"metric-card\">\n            <div class=\"metric-value\">{{formatNumber(20.totalReach; \"#,##0\")}}</div>\n            <div class=\"metric-label\">Total Reach</div>\n        </div>\n        <div class=\"metric-card\">\n            <div class=\"metric-value\">{{21.avgEngagementRate}}%</div>\n            <div class=\"metric-label\">Avg Engagement Rate</div>\n        </div>\n    </div>\n    \n    <div class=\"platform-section\">\n        <div class=\"platform-title\">\n            <h2>📘 Facebook Performance</h2>\n        </div>\n        <div class=\"platform-stats\">\n            <div class=\"platform-stat\">\n                <strong>{{formatNumber(10.facebookImpressions; \"#,##0\")}}</strong><br>\n                <small>Impressions</small>\n            </div>\n            <div class=\"platform-stat\">\n                <strong>{{formatNumber(11.facebookReach; \"#,##0\")}}</strong><br>\n                <small>Reach</small>\n            </div>\n            <div class=\"platform-stat\">\n                <strong>{{12.facebookEngagementRate}}%</strong><br>\n                <small>Engagement Rate</small>\n            </div>\n        </div>\n    </div>\n    \n    <div class=\"platform-section\">\n        <div class=\"platform-title\">\n            <h2>🐦 Twitter Performance</h2>\n        </div>\n        <div class=\"platform-stats\">\n            <div class=\"platform-stat\">\n                <strong>{{formatNumber(13.twitterImpressions; \"#,##0\")}}</strong><br>\n                <small>Impressions</small>\n            </div>\n            <div class=\"platform-stat\">\n                <strong>{{formatNumber(14.twitterEngagements; \"#,##0\")}}</strong><br>\n                <small>Engagements</small>\n            </div>\n            <div class=\"platform-stat\">\n                <strong>{{15.twitterEngagementRate}}%</strong><br>\n                <small>Engagement Rate</small>\n            </div>\n        </div>\n    </div>\n    \n    <div class=\"platform-section\">\n        <div class=\"platform-title\">\n            <h2>💼 LinkedIn Performance</h2>\n        </div>\n        <div class=\"platform-stats\">\n            <div class=\"platform-stat\">\n                <strong>{{formatNumber(16.linkedinImpressions; \"#,##0\")}}</strong><br>\n                <small>Impressions</small>\n            </div>\n            <div class=\"platform-stat\">\n                <strong>{{formatNumber(17.linkedinReach; \"#,##0\")}}</strong><br>\n                <small>Reach</small>\n            </div>\n            <div class=\"platform-stat\">\n                <strong>{{18.linkedinEngagementRate}}%</strong><br>\n                <small>Engagement Rate</small>\n            </div>\n        </div>\n    </div>\n    \n    <div class=\"footer\">\n        <p>Generated automatically by Make.com on {{formatDate(now; \"MMMM DD, YYYY at HH:mm\")}}</p>\n    </div>\n</body>\n</html>",
        "name": "htmlReport"
      },
      "metadata": {
        "designer": {
          "x": 2100,
          "y": 50,
          "name": "Generate HTML Report"
        }
      }
    },
    {
      "id": 24,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "scope": "roundtrip",
        "value": "WEEKLY SOCIAL MEDIA ANALYTICS REPORT\n{{formatDate(2.startDate; \"MMMM DD\")}} - {{formatDate(3.endDate; \"MMMM DD, YYYY\")}}\n\n=== OVERVIEW ===\nTotal Impressions: {{formatNumber(19.totalImpressions; \"#,##0\")}}\nTotal Reach: {{formatNumber(20.totalReach; \"#,##0\")}}\nAverage Engagement Rate: {{21.avgEngagementRate}}%\n\n=== FACEBOOK PERFORMANCE ===\nImpressions: {{formatNumber(10.facebookImpressions; \"#,##0\")}}\nReach: {{formatNumber(11.facebookReach; \"#,##0\")}}\nEngagement Rate: {{12.facebookEngagementRate}}%\n\n=== TWITTER PERFORMANCE ===\nImpressions: {{formatNumber(13.twitterImpressions; \"#,##0\")}}\nEngagements: {{formatNumber(14.twitterEngagements; \"#,##0\")}}\nEngagement Rate: {{15.twitterEngagementRate}}%\n\n=== LINKEDIN PERFORMANCE ===\nImpressions: {{formatNumber(16.linkedinImpressions; \"#,##0\")}}\nReach: {{formatNumber(17.linkedinReach; \"#,##0\")}}\nEngagement Rate: {{18.linkedinEngagementRate}}%\n\n---\nGenerated automatically by Make.com on {{formatDate(now; \"MMMM DD, YYYY at HH:mm\")}}",
        "name": "textReport"
      },
      "metadata": {
        "designer": {
          "x": 2100,
          "y": 100,
          "name": "Generate Text Report"
        }
      }
    },
    {
      "id": 25,
      "module": "email:ActionSendEmailAdvanced",
      "version": 1,
      "parameters": {},
      "mapper": {
        "to": "{{connection.recipients}}",
        "subject": "{{22.emailSubject}}",
        "html": "{{23.htmlReport}}",
        "text": "{{24.textReport}}",
        "from": "{{connection.fromEmail}}"
      },
      "metadata": {
        "designer": {
          "x": 2400,
          "y": 75,
          "name": "Send Analytics Report Email"
        }
      }
    },
    {
      "id": 26,
      "module": "util:ErrorHandler",
      "version": 1,
      "parameters": {
        "directive": "ignore",
        "retry": 3,
        "interval": 30
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 1200,
          "y": -300,
          "name": "Facebook API Error Handler"
        }
      }
    },
    {
      "id": 27,
      "module": "util:ErrorHandler",
      "version": 1,
      "parameters": {
        "directive": "ignore",
        "retry": 3,
        "interval": 30
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 1200,
          "y": -200,
          "name": "Twitter API Error Handler"
        }
      }
    },
    {
      "id": 28,
      "module": "util:ErrorHandler",
      "version": 1,
      "parameters": {
        "directive": "ignore",
        "retry": 3,
        "interval": 30
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 300,
          "name": "LinkedIn API Error Handler"
        }
      }
    },
    {
      "id": 29,
      "module": "email:ActionSendEmailAdvanced",
      "version": 1,
      "parameters": {},
      "mapper": {
        "to": "{{connection.adminEmail}}",
        "subject": "🚨 Social Media Analytics Error - {{formatDate(now; \"YYYY-MM-DD HH:mm\")}}",
        "text": "An error occurred while fetching social media analytics:\n\nError Details:\n- Module: {{error.module}}\n- Message: {{error.message}}\n- Time: {{formatDate(now; \"YYYY-MM-DD HH:mm:ss\")}}\n- Scenario: {{scenario.name}}\n\nPlease check the Make.com dashboard for more details.\n\nThis is an automated notification.",
        "from": "{{connection.fromEmail}}"
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": -300,
          "name": "Send Error Notification"
        }
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "scheduling": {
        "type": "cron",
        "cron": "0 8 * * 1"
      }
    },
    "designer": {
      "orphans": []
    }
  },
  "routes": [
    {
      "flow": [
        {
          "id": 4,
          "module": "http:ActionSendData",
          "version": 3,
          "parameters": {
            "handleErrors": true
          },
          "mapper": {
            "url": "https://graph.facebook.com/v18.0/me/insights",
            "method": "GET",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer {{connection.facebookAccessToken}}"
              }
            ],
            "qs": [
              {
                "name": "metric",
                "value": "page_impressions,page_reach,page_engaged_users"
              },
              {
                "name": "since",
                "value": "{{2.startDate}}"
              },
              {
                "name": "until",
                "value": "{{3.endDate}}"
              },
              {
                "name": "period",
                "value": "week"
              }
            ]
          },
          "metadata": {
            "designer": {
              "x": 900,
              "y": -150,
              "name": "Fetch Facebook Analytics"
            }
          }
        },
        {
          "id": 26,
          "module": "util:ErrorHandler",
          "version": 1,
          "parameters": {
            "directive": "ignore",
            "retry": 3,
            "interval": 30
          },
          "mapper": {},
          "metadata": {
            "designer": {
              "x": 1200,
              "y": -300,
              "name": "Facebook API Error Handler"
            }
          }
        }
      ]
    },
    {
      "flow": [
        {
          "id": 5,
          "module": "http:ActionSendData",
          "version": 3,
          "parameters": {
            "handleErrors": true
          },
          "mapper": {
            "url": "https://api.twitter.com/2/users/me/tweets",
            "method": "GET",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer {{connection.twitterBearerToken}}"
              }
            ],
            "qs": [
              {
                "name": "tweet.fields",
                "value": "public_metrics,created_at"
              },
              {
